# Copy to .env and fill in values (do not commit .env)

# ---------------------------------------------------------------
# DATABASE: Pick ONE mode
# ---------------------------------------------------------------

# Option A: SQL Server (production mode - requires pyodbc)
DB_SERVER=localhost
DB_NAME=StockPulse
DB_DRIVER=ODBC+Driver+17+for+SQL+Server
DB_TRUSTED_CONNECTION=yes
# DB_USERNAME=your_user
# DB_PASSWORD=your_password

# Option B: SQLite (quick demo mode - no SQL Server needed)
# Set this to 'true' to use a local SQLite database instead of SQL Server.
# Useful for quick demos or when SQL Server is not available.
USE_SQLITE=false

# Optional: daily job time for python -m etl.job_scheduler (24h local clock)
# ETL_SCHEDULE_TIME=10:00
